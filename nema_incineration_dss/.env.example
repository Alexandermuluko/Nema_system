SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database: sqlite or postgresql
# When DATABASE_URL is set, it takes precedence over DB_ENGINE.
DATABASE_URL=
DB_ENGINE=sqlite
DB_NAME=nema_dss
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Neon Object Storage (needed for persistent uploads on Vercel)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_STORAGE_BUCKET_NAME=nema-dss-files

# Optional: set this to an absolute path for uploaded files.
MEDIA_ROOT=
